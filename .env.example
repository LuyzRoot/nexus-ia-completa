# .env.example - copie para .env e preencha os valores sensíveis (NÃO comitar .env)
# Ambiente e debug
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database (Postgres)
# Exemplo local: postgresql://nexus:nexus@localhost:5432/nexus_db
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus_db

# Redis (opcional - usado para cache / tasks)
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
JWT_SECRET_KEY=replace-with-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Providers (coloque as chaves reais no .env)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Voice & STT
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# WhatsApp integration (optional)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_NUMBERS=

# Home Assistant (optional)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Monitoring / Tracing (optional)
SENTRY_DSN=
OTLP_ENDPOINT=  # ex: http://otel-collector:4318
SERVICE_NAME=nexus

# Prometheus - se usar o compose local, mantenha defaults
PROMETHEUS_SCRAPE=true

# Other runtime flags
# Set to "true" in production only when you know what you do
ENABLE_TELEMETRY=false
