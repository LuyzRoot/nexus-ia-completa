# Exemplo de variáveis de ambiente para desenvolvimento
# Copie este arquivo para `.env` e edite conforme necessário.

# Chaves de API
# OPENAI_KEY=sk-xxxxx

# Banco de dados (em dev usamos SQLite por padrão)
DATABASE_URL=sqlite:///dev.db

# Outros exemplos
# SECRET_KEY=sua_chave_aqui
# REDIS_URL=redis://localhost:6379/0
